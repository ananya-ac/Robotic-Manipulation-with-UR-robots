<?xml version="1.0" encoding="UTF-8"?>
<!--
  MoveIt 2 semantic description for the ur_gripper_sim bringups (UR + Robotiq Hand-E / 2F-85).

  Wraps the upstream ur_moveit_config arm SRDF (the `ur_manipulator` planning group + UR
  self-collision rules) and adds, per gripper:
    * disable_collisions for the gripper links — move_group reads robot_description (arm +
      gripper) from the running gz bringup's topic, so without these the rigidly-attached
      gripper links register as start-state self-collisions and every plan is rejected (-10);
    * (when load_gripper) a `gripper` planning group (the single actuated joint; mimics follow
      via the URDF), open/close group_states, and an end_effector on tool0 — so MoveIt can
      actuate the gripper.

  Args:  name (ur_type), gripper (hande | robotiq_2f85), load_gripper (true | false)
-->
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="$(arg name)">

  <xacro:arg name="name" default="ur"/>
  <xacro:arg name="gripper" default="hande"/>
  <xacro:arg name="load_gripper" default="true"/>

  <xacro:include filename="$(find ur_moveit_config)/srdf/ur_macro.srdf.xacro"/>
  <xacro:ur_srdf/>

  <!-- ================= Robotiq Hand-E ================= -->
  <xacro:if value="${'$(arg gripper)' == 'hande'}">
    <xacro:if value="${'$(arg load_gripper)' == 'true'}">
      <group name="gripper">
        <joint name="finger_joint"/>
      </group>
      <!-- finger_joint (prismatic): 0.002 = open, 0.02 = closed (URDF limits) -->
      <group_state name="open" group="gripper">
        <joint name="finger_joint" value="0.002"/>
      </group_state>
      <group_state name="close" group="gripper">
        <joint name="finger_joint" value="0.02"/>
      </group_state>
      <end_effector name="hande" parent_link="tool0" group="gripper" parent_group="ur_manipulator"/>
    </xacro:if>

    <disable_collisions link1="flange" link2="hand_e_link" reason="Adjacent"/>
    <disable_collisions link1="flange" link2="hande_left_finger" reason="Adjacent"/>
    <disable_collisions link1="flange" link2="hande_right_finger" reason="Adjacent"/>
    <disable_collisions link1="flange" link2="robotiq_coupler" reason="Adjacent"/>
    <disable_collisions link1="hand_e_link" link2="hande_left_finger" reason="Adjacent"/>
    <disable_collisions link1="hand_e_link" link2="hande_right_finger" reason="Adjacent"/>
    <disable_collisions link1="hand_e_link" link2="robotiq_coupler" reason="Adjacent"/>
    <disable_collisions link1="hand_e_link" link2="tool0" reason="Adjacent"/>
    <disable_collisions link1="hand_e_link" link2="wrist_3_link" reason="Adjacent"/>
    <disable_collisions link1="hande_left_finger" link2="hande_right_finger" reason="Adjacent"/>
    <disable_collisions link1="hande_left_finger" link2="robotiq_coupler" reason="Adjacent"/>
    <disable_collisions link1="hande_left_finger" link2="tool0" reason="Adjacent"/>
    <disable_collisions link1="hande_left_finger" link2="wrist_3_link" reason="Adjacent"/>
    <disable_collisions link1="hande_right_finger" link2="robotiq_coupler" reason="Adjacent"/>
    <disable_collisions link1="hande_right_finger" link2="tool0" reason="Adjacent"/>
    <disable_collisions link1="hande_right_finger" link2="wrist_3_link" reason="Adjacent"/>
    <disable_collisions link1="robotiq_coupler" link2="tool0" reason="Adjacent"/>
    <disable_collisions link1="robotiq_coupler" link2="wrist_3_link" reason="Adjacent"/>
  </xacro:if>

  <!-- ================= Robotiq 2F-85 (PickNik robotiq_description + ur_to_robotiq adapter) ================= -->
  <xacro:if value="${'$(arg gripper)' == 'robotiq_2f85'}">
    <xacro:if value="${'$(arg load_gripper)' == 'true'}">
      <group name="gripper">
        <joint name="robotiq_85_left_knuckle_joint"/>
      </group>
      <!-- knuckle (revolute): 0.0 = open, 0.8 = closed (URDF limits) -->
      <group_state name="open" group="gripper">
        <joint name="robotiq_85_left_knuckle_joint" value="0.0"/>
      </group_state>
      <group_state name="close" group="gripper">
        <joint name="robotiq_85_left_knuckle_joint" value="0.8"/>
      </group_state>
      <end_effector name="robotiq_2f85" parent_link="tool0" group="gripper" parent_group="ur_manipulator"/>
    </xacro:if>

    <disable_collisions link1="flange" link2="gripper_mount_link" reason="Adjacent"/>
    <disable_collisions link1="flange" link2="robotiq_85_base_link" reason="Adjacent"/>
    <disable_collisions link1="flange" link2="robotiq_85_left_finger_link" reason="Adjacent"/>
    <disable_collisions link1="flange" link2="robotiq_85_left_finger_tip_link" reason="Adjacent"/>
    <disable_collisions link1="flange" link2="robotiq_85_left_inner_knuckle_link" reason="Adjacent"/>
    <disable_collisions link1="flange" link2="robotiq_85_left_knuckle_link" reason="Adjacent"/>
    <disable_collisions link1="flange" link2="robotiq_85_right_finger_link" reason="Adjacent"/>
    <disable_collisions link1="flange" link2="robotiq_85_right_finger_tip_link" reason="Adjacent"/>
    <disable_collisions link1="flange" link2="robotiq_85_right_inner_knuckle_link" reason="Adjacent"/>
    <disable_collisions link1="flange" link2="robotiq_85_right_knuckle_link" reason="Adjacent"/>
    <disable_collisions link1="flange" link2="ur_to_robotiq_link" reason="Adjacent"/>
    <disable_collisions link1="gripper_mount_link" link2="robotiq_85_base_link" reason="Adjacent"/>
    <disable_collisions link1="gripper_mount_link" link2="robotiq_85_left_finger_link" reason="Adjacent"/>
    <disable_collisions link1="gripper_mount_link" link2="robotiq_85_left_finger_tip_link" reason="Adjacent"/>
    <disable_collisions link1="gripper_mount_link" link2="robotiq_85_left_inner_knuckle_link" reason="Adjacent"/>
    <disable_collisions link1="gripper_mount_link" link2="robotiq_85_left_knuckle_link" reason="Adjacent"/>
    <disable_collisions link1="gripper_mount_link" link2="robotiq_85_right_finger_link" reason="Adjacent"/>
    <disable_collisions link1="gripper_mount_link" link2="robotiq_85_right_finger_tip_link" reason="Adjacent"/>
    <disable_collisions link1="gripper_mount_link" link2="robotiq_85_right_inner_knuckle_link" reason="Adjacent"/>
    <disable_collisions link1="gripper_mount_link" link2="robotiq_85_right_knuckle_link" reason="Adjacent"/>
    <disable_collisions link1="gripper_mount_link" link2="tool0" reason="Adjacent"/>
    <disable_collisions link1="gripper_mount_link" link2="ur_to_robotiq_link" reason="Adjacent"/>
    <disable_collisions link1="gripper_mount_link" link2="wrist_3_link" reason="Adjacent"/>
    <disable_collisions link1="robotiq_85_base_link" link2="robotiq_85_left_finger_link" reason="Adjacent"/>
    <disable_collisions link1="robotiq_85_base_link" link2="robotiq_85_left_finger_tip_link" reason="Adjacent"/>
    <disable_collisions link1="robotiq_85_base_link" link2="robotiq_85_left_inner_knuckle_link" reason="Adjacent"/>
    <disable_collisions link1="robotiq_85_base_link" link2="robotiq_85_left_knuckle_link" reason="Adjacent"/>
    <disable_collisions link1="robotiq_85_base_link" link2="robotiq_85_right_finger_link" reason="Adjacent"/>
    <disable_collisions link1="robotiq_85_base_link" link2="robotiq_85_right_finger_tip_link" reason="Adjacent"/>
    <disable_collisions link1="robotiq_85_base_link" link2="robotiq_85_right_inner_knuckle_link" reason="Adjacent"/>
    <disable_collisions link1="robotiq_85_base_link" link2="robotiq_85_right_knuckle_link" reason="Adjacent"/>
    <disable_collisions link1="robotiq_85_base_link" link2="tool0" reason="Adjacent"/>
    <disable_collisions link1="robotiq_85_base_link" link2="ur_to_robotiq_link" reason="Adjacent"/>
    <disable_collisions link1="robotiq_85_base_link" link2="wrist_3_link" reason="Adjacent"/>
    <disable_collisions link1="robotiq_85_left_finger_link" link2="robotiq_85_left_finger_tip_link" reason="Adjacent"/>
    <disable_collisions link1="robotiq_85_left_finger_link" link2="robotiq_85_left_inner_knuckle_link" reason="Adjacent"/>
    <disable_collisions link1="robotiq_85_left_finger_link" link2="robotiq_85_left_knuckle_link" reason="Adjacent"/>
    <disable_collisions link1="robotiq_85_left_finger_link" link2="robotiq_85_right_finger_link" reason="Adjacent"/>
    <disable_collisions link1="robotiq_85_left_finger_link" link2="robotiq_85_right_finger_tip_link" reason="Adjacent"/>
    <disable_collisions link1="robotiq_85_left_finger_link" link2="robotiq_85_right_inner_knuckle_link" reason="Adjacent"/>
    <disable_collisions link1="robotiq_85_left_finger_link" link2="robotiq_85_right_knuckle_link" reason="Adjacent"/>
    <disable_collisions link1="robotiq_85_left_finger_link" link2="tool0" reason="Adjacent"/>
    <disable_collisions link1="robotiq_85_left_finger_link" link2="ur_to_robotiq_link" reason="Adjacent"/>
    <disable_collisions link1="robotiq_85_left_finger_link" link2="wrist_3_link" reason="Adjacent"/>
    <disable_collisions link1="robotiq_85_left_finger_tip_link" link2="robotiq_85_left_inner_knuckle_link" reason="Adjacent"/>
    <disable_collisions link1="robotiq_85_left_finger_tip_link" link2="robotiq_85_left_knuckle_link" reason="Adjacent"/>
    <disable_collisions link1="robotiq_85_left_finger_tip_link" link2="robotiq_85_right_finger_link" reason="Adjacent"/>
    <disable_collisions link1="robotiq_85_left_finger_tip_link" link2="robotiq_85_right_finger_tip_link" reason="Adjacent"/>
    <disable_collisions link1="robotiq_85_left_finger_tip_link" link2="robotiq_85_right_inner_knuckle_link" reason="Adjacent"/>
    <disable_collisions link1="robotiq_85_left_finger_tip_link" link2="robotiq_85_right_knuckle_link" reason="Adjacent"/>
    <disable_collisions link1="robotiq_85_left_finger_tip_link" link2="tool0" reason="Adjacent"/>
    <disable_collisions link1="robotiq_85_left_finger_tip_link" link2="ur_to_robotiq_link" reason="Adjacent"/>
    <disable_collisions link1="robotiq_85_left_finger_tip_link" link2="wrist_3_link" reason="Adjacent"/>
    <disable_collisions link1="robotiq_85_left_inner_knuckle_link" link2="robotiq_85_left_knuckle_link" reason="Adjacent"/>
    <disable_collisions link1="robotiq_85_left_inner_knuckle_link" link2="robotiq_85_right_finger_link" reason="Adjacent"/>
    <disable_collisions link1="robotiq_85_left_inner_knuckle_link" link2="robotiq_85_right_finger_tip_link" reason="Adjacent"/>
    <disable_collisions link1="robotiq_85_left_inner_knuckle_link" link2="robotiq_85_right_inner_knuckle_link" reason="Adjacent"/>
    <disable_collisions link1="robotiq_85_left_inner_knuckle_link" link2="robotiq_85_right_knuckle_link" reason="Adjacent"/>
    <disable_collisions link1="robotiq_85_left_inner_knuckle_link" link2="tool0" reason="Adjacent"/>
    <disable_collisions link1="robotiq_85_left_inner_knuckle_link" link2="ur_to_robotiq_link" reason="Adjacent"/>
    <disable_collisions link1="robotiq_85_left_inner_knuckle_link" link2="wrist_3_link" reason="Adjacent"/>
    <disable_collisions link1="robotiq_85_left_knuckle_link" link2="robotiq_85_right_finger_link" reason="Adjacent"/>
    <disable_collisions link1="robotiq_85_left_knuckle_link" link2="robotiq_85_right_finger_tip_link" reason="Adjacent"/>
    <disable_collisions link1="robotiq_85_left_knuckle_link" link2="robotiq_85_right_inner_knuckle_link" reason="Adjacent"/>
    <disable_collisions link1="robotiq_85_left_knuckle_link" link2="robotiq_85_right_knuckle_link" reason="Adjacent"/>
    <disable_collisions link1="robotiq_85_left_knuckle_link" link2="tool0" reason="Adjacent"/>
    <disable_collisions link1="robotiq_85_left_knuckle_link" link2="ur_to_robotiq_link" reason="Adjacent"/>
    <disable_collisions link1="robotiq_85_left_knuckle_link" link2="wrist_3_link" reason="Adjacent"/>
    <disable_collisions link1="robotiq_85_right_finger_link" link2="robotiq_85_right_finger_tip_link" reason="Adjacent"/>
    <disable_collisions link1="robotiq_85_right_finger_link" link2="robotiq_85_right_inner_knuckle_link" reason="Adjacent"/>
    <disable_collisions link1="robotiq_85_right_finger_link" link2="robotiq_85_right_knuckle_link" reason="Adjacent"/>
    <disable_collisions link1="robotiq_85_right_finger_link" link2="tool0" reason="Adjacent"/>
    <disable_collisions link1="robotiq_85_right_finger_link" link2="ur_to_robotiq_link" reason="Adjacent"/>
    <disable_collisions link1="robotiq_85_right_finger_link" link2="wrist_3_link" reason="Adjacent"/>
    <disable_collisions link1="robotiq_85_right_finger_tip_link" link2="robotiq_85_right_inner_knuckle_link" reason="Adjacent"/>
    <disable_collisions link1="robotiq_85_right_finger_tip_link" link2="robotiq_85_right_knuckle_link" reason="Adjacent"/>
    <disable_collisions link1="robotiq_85_right_finger_tip_link" link2="tool0" reason="Adjacent"/>
    <disable_collisions link1="robotiq_85_right_finger_tip_link" link2="ur_to_robotiq_link" reason="Adjacent"/>
    <disable_collisions link1="robotiq_85_right_finger_tip_link" link2="wrist_3_link" reason="Adjacent"/>
    <disable_collisions link1="robotiq_85_right_inner_knuckle_link" link2="robotiq_85_right_knuckle_link" reason="Adjacent"/>
    <disable_collisions link1="robotiq_85_right_inner_knuckle_link" link2="tool0" reason="Adjacent"/>
    <disable_collisions link1="robotiq_85_right_inner_knuckle_link" link2="ur_to_robotiq_link" reason="Adjacent"/>
    <disable_collisions link1="robotiq_85_right_inner_knuckle_link" link2="wrist_3_link" reason="Adjacent"/>
    <disable_collisions link1="robotiq_85_right_knuckle_link" link2="tool0" reason="Adjacent"/>
    <disable_collisions link1="robotiq_85_right_knuckle_link" link2="ur_to_robotiq_link" reason="Adjacent"/>
    <disable_collisions link1="robotiq_85_right_knuckle_link" link2="wrist_3_link" reason="Adjacent"/>
    <disable_collisions link1="tool0" link2="ur_to_robotiq_link" reason="Adjacent"/>
    <disable_collisions link1="ur_to_robotiq_link" link2="wrist_3_link" reason="Adjacent"/>
  </xacro:if>

</robot>
