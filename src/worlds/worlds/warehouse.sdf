<?xml version="1.0" ?>
<!--
  Warehouse world for gz-sim (Harmonic), assembled from two verified sources:

  - System plugins + physics timing: copied from the stock world shipped with
    gz-sim (/opt/ros/jazzy/opt/gz_sim_vendor/share/gz/gz-sim8/worlds/empty.sdf),
    PLUS the Sensors system, which that stock world does NOT load. Without it,
    no rendering-based sensor (camera, depth camera, lidar) ever produces
    output. physics timing (1ms step) is kept at the stock world's value rather
    than the source warehouse scene's own (10ms) so it stays consistent with
    this workspace's controllers (e.g. 500Hz update rates in
    ur_gz_2f85_controllers.yaml).

  - Scene content (models, light): from OpenRobotics' own "industrial-warehouse"
    world on Gazebo Fuel (owner OpenRobotics). Its original form wraps each
    <include> in its own <model name="..."> tag (a nested-model construct);
    that's rewritten here as flat top-level <include> entries (each with its
    own <name>/<pose>) instead, because bullet-featherstone (required for
    this workspace's gripper mimic joints) does not implement
    ConstructSdfNestedModel (gazebosim/gz-physics#546): under the original
    nested form, none of these models were being constructed as real physics
    bodies at all, so nothing (including the ground) had working collision and
    everything free-fell. Flat <include> avoids the nested-model path entirely.
    Model geometry is NOT vendored here; each <uri> pulls the actual AWS
    RoboMaker warehouse model from Fuel over the network on first load, then
    gz-sim caches it locally. First launch needs internet access; later
    launches don't.
-->
<sdf version="1.9">
  <world name="warehouse">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin
      filename="gz-sim-contact-system"
      name="gz::sim::systems::Contact">
    </plugin>
    <!-- The camera fix: without this, rgbd_camera/camera/depth_camera/lidar sensors are
         created (their gz topics exist) but never actually render, so they publish
         nothing at all. -->
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <gravity>0 0 -9.8</gravity>

    <include>
      <name>aws_robomaker_warehouse_ShelfF_01_001</name>
      <pose>-5.795143 -0.956635 0 0 0 0</pose>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/aws_robomaker_warehouse_ShelfF_01</uri>
    </include>

    <include>
      <name>aws_robomaker_warehouse_WallB_01_001</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/aws_robomaker_warehouse_WallB_01</uri>
    </include>

    <include>
      <name>aws_robomaker_warehouse_ShelfE_01_001</name>
      <pose>4.73156 0.57943 0 0 0 0</pose>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/aws_robomaker_warehouse_ShelfE_01</uri>
    </include>

    <include>
      <name>aws_robomaker_warehouse_ShelfE_01_002</name>
      <pose>4.73156 -4.827049 0 0 0 0</pose>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/aws_robomaker_warehouse_ShelfE_01</uri>
    </include>

    <include>
      <name>aws_robomaker_warehouse_ShelfE_01_003</name>
      <pose>4.73156 -8.6651 0 0 0 0</pose>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/aws_robomaker_warehouse_ShelfE_01</uri>
    </include>

    <include>
      <name>aws_robomaker_warehouse_ShelfD_01_001</name>
      <pose>4.73156 -1.242668 0 0 0 0</pose>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/aws_robomaker_warehouse_ShelfD_01</uri>
    </include>

    <include>
      <name>aws_robomaker_warehouse_ShelfD_01_002</name>
      <pose>4.73156 -3.038551 0 0 0 0</pose>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/aws_robomaker_warehouse_ShelfD_01</uri>
    </include>

    <include>
      <name>aws_robomaker_warehouse_ShelfD_01_003</name>
      <pose>4.73156 -6.750542 0 0 0 0</pose>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/aws_robomaker_warehouse_ShelfD_01</uri>
    </include>

    <include>
      <name>aws_robomaker_warehouse_GroundB_01_001</name>
      <pose>0.0 0.0 -0.090092 0 0 0</pose>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/aws_robomaker_warehouse_GroundB_01</uri>
    </include>

    <include>
      <name>aws_robomaker_warehouse_Lamp_01_005</name>
      <pose>0 0 -4 0 0 0</pose>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/aws_robomaker_warehouse_Lamp_01</uri>
    </include>

    <include>
      <name>aws_robomaker_warehouse_Bucket_01_020</name>
      <pose>0.433449 9.631706 0 0 0 -1.563161</pose>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/aws_robomaker_warehouse_Bucket_01</uri>
    </include>

    <include>
      <name>aws_robomaker_warehouse_Bucket_01_021</name>
      <pose>-1.8321 -6.3752 0 0 0 -1.563161</pose>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/aws_robomaker_warehouse_Bucket_01</uri>
    </include>

    <include>
      <name>aws_robomaker_warehouse_Bucket_01_022</name>
      <pose>0.433449 8.59 0 0 0 -1.563161</pose>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/aws_robomaker_warehouse_Bucket_01</uri>
    </include>

    <include>
      <name>aws_robomaker_warehouse_ClutteringA_01_016</name>
      <pose>5.708138 8.616844 -0.017477 0 0 0</pose>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/aws_robomaker_warehouse_ClutteringA_01</uri>
    </include>

    <include>
      <name>aws_robomaker_warehouse_ClutteringA_01_017</name>
      <pose>3.408638 8.616844 -0.017477 0 0 0</pose>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/aws_robomaker_warehouse_ClutteringA_01</uri>
    </include>

    <include>
      <name>aws_robomaker_warehouse_ClutteringA_01_018</name>
      <pose>-1.491287 5.222435 -0.017477 0 0 -1.583185</pose>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/aws_robomaker_warehouse_ClutteringA_01</uri>
    </include>

    <include>
      <name>aws_robomaker_warehouse_ClutteringC_01_027</name>
      <pose>3.324959 3.822449 -0.012064 0 0 1.563871</pose>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/aws_robomaker_warehouse_ClutteringC_01</uri>
    </include>

    <include>
      <name>aws_robomaker_warehouse_ClutteringC_01_028</name>
      <pose>5.54171 3.816475 -0.015663 0 0 -1.583191</pose>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/aws_robomaker_warehouse_ClutteringC_01</uri>
    </include>

    <include>
      <name>aws_robomaker_warehouse_ClutteringC_01_029</name>
      <pose>5.384239 6.137154 0 0 0 3.150000</pose>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/aws_robomaker_warehouse_ClutteringC_01</uri>
    </include>

    <include>
      <name>aws_robomaker_warehouse_ClutteringC_01_030</name>
      <pose>3.236 6.137154 0 0 0 3.150000</pose>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/aws_robomaker_warehouse_ClutteringC_01</uri>
    </include>

    <include>
      <name>aws_robomaker_warehouse_ClutteringC_01_031</name>
      <pose>-1.573677 2.301994 -0.015663 0 0 -3.133191</pose>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/aws_robomaker_warehouse_ClutteringC_01</uri>
    </include>

    <include>
      <name>aws_robomaker_warehouse_ClutteringC_01_032</name>
      <pose>-1.2196 9.407 -0.015663 0 0 1.563871</pose>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/aws_robomaker_warehouse_ClutteringC_01</uri>
    </include>

    <include>
      <name>aws_robomaker_warehouse_ClutteringD_01_005</name>
      <pose>-1.634682 -7.811813 -0.319559 0 0 0</pose>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/aws_robomaker_warehouse_ClutteringD_01</uri>
    </include>

    <include>
      <name>aws_robomaker_warehouse_TrashCanC_01_002</name>
      <pose>-1.592441 7.715420 0 0 0 0</pose>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/aws_robomaker_warehouse_TrashCanC_01</uri>
    </include>

    <include>
      <name>aws_robomaker_warehouse_PalletJackB_01_001</name>
      <pose>-0.276098 -9.481944 0.023266 0 0 0</pose>
      <static>true</static>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/aws_robomaker_warehouse_PalletJackB_01</uri>
    </include>

    <light name="Warehouse_CeilingLight_003" type="point">
      <pose>0 0 8.5 0 0 0</pose>
      <diffuse>0.5 0.5 0.5 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>80</range>
        <constant>0.3</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <cast_shadows>1</cast_shadows>
      <direction>0.1 0.1 -1</direction>
    </light>

  </world>
</sdf>
