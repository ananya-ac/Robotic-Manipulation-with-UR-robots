<?xml version="1.0" ?>
<!--
  Hardware-agnostic D435 wrist-camera mount, with a detailed multi-material visual.

  This reimplements realsense2_description's own sensor_d435 macro (urdf/_d435.urdf.xacro)
  rather than calling it, ONLY to replace its single flat-gray-material visual with the
  9-part colored mesh set in meshes/d435i/ (vendored from Google DeepMind's MuJoCo
  Menagerie, see meshes/README.md). Every joint, link, frame name, collision box, and
  inertial value below is copied unchanged from that vendor macro; this is a fork of
  its structure for the visual only, not a redesign. If realsense2_description's _d435
  ever changes those values, this won't pick it up automatically; check meshes/README.md's
  provenance note if that matters.

  `sim` maps to the same use_nominal_extrinsics concept the vendor macro uses:
    - sim:=true  -> nominal (approximate) depth/color/infra optical frames are generated.
      Needed in gz-sim since nothing else publishes them.
    - sim:=false -> those frames are NOT generated; a real realsense2_camera driver node
      publishes its own factory-calibrated extrinsics over tf at runtime instead.

  See realsense_d435.gazebo.xacro for the sim-only gz sensor plugin (separate file so
  this one stays hardware-agnostic).
-->
<robot xmlns:xacro="http://wiki.ros.org/xacro">

  <xacro:macro name="ur_camera_d435" params="parent tf_prefix:='' sim:=true *origin">
    <xacro:property name="M_PI" value="3.1415926535897931"/>

    <!-- Vendored from realsense2_description/urdf/_d435.urdf.xacro; keep in sync with
         that file's own values if it's ever updated (see meshes/README.md). -->
    <xacro:property name="d435_cam_depth_to_infra1_offset" value="0.0"/>
    <xacro:property name="d435_cam_depth_to_infra2_offset" value="-0.050"/>
    <xacro:property name="d435_cam_depth_to_color_offset" value="0.015"/>
    <xacro:property name="d435_cam_width" value="0.090"/>
    <xacro:property name="d435_cam_height" value="0.025"/>
    <xacro:property name="d435_cam_depth" value="0.02505"/>
    <xacro:property name="d435_cam_mount_from_center_offset" value="0.0149"/>
    <xacro:property name="d435_glass_to_front" value="0.1e-3"/>
    <xacro:property name="d435_zero_depth_to_glass" value="4.2e-3"/>
    <xacro:property name="d435_mesh_x_offset"
      value="${d435_cam_mount_from_center_offset - d435_glass_to_front - d435_zero_depth_to_glass}"/>
    <xacro:property name="d435_cam_depth_px" value="${d435_cam_mount_from_center_offset}"/>
    <xacro:property name="d435_cam_depth_py" value="0.0175"/>
    <xacro:property name="d435_cam_depth_pz" value="${d435_cam_height/2}"/>

    <joint name="${tf_prefix}camera_joint" type="fixed">
      <xacro:insert_block name="origin"/>
      <parent link="${parent}"/>
      <child link="${tf_prefix}camera_bottom_screw_frame"/>
    </joint>
    <link name="${tf_prefix}camera_bottom_screw_frame"/>

    <joint name="${tf_prefix}camera_link_joint" type="fixed">
      <origin xyz="${d435_mesh_x_offset} ${d435_cam_depth_py} ${d435_cam_depth_pz}" rpy="0 0 0"/>
      <parent link="${tf_prefix}camera_bottom_screw_frame"/>
      <child link="${tf_prefix}camera_link"/>
    </joint>

    <link name="${tf_prefix}camera_link">
      <!-- 9-part colored visual (meshes/README.md). Same origin/rotation the vendor
           macro applies to its single .dae mesh: these OBJs are split/recolored
           copies of that exact mesh, confirmed by matching vertex bounding boxes,
           so they share its coordinate frame.

           Each part lives in its own part_N/ subdirectory alongside its own
           material_0.mtl: every d435i_N.obj references the identical generic
           "mtllib material_0.mtl" / "usemtl material_0" (an obj2mjcf artifact,
           not real per-part material data; MuJoCo Menagerie sources color from
           its own MJCF file, not from .mtl at all). gz's OBJ loader resolves
           material_0.mtl relative to each .obj's own directory, so per-part
           subdirectories are what makes 9 different colors possible here instead
           of one shared (and therefore ignored-per-part) material_0.mtl. The
           <material><color> below is a belt-and-suspenders duplicate of the same
           color for any loader path that prefers URDF-level material over the
           .mtl. -->
      <xacro:macro name="camera_visual_part" params="mesh_index rgba">
        <visual>
          <origin xyz="${d435_zero_depth_to_glass + d435_glass_to_front} ${-d435_cam_depth_py} 0"
                  rpy="${M_PI/2} 0 ${M_PI/2}"/>
          <geometry>
            <mesh filename="package://ur_camera_gz/meshes/d435i/part_${mesh_index}/d435i_${mesh_index}.obj"/>
          </geometry>
          <material name="d435i_part_${mesh_index}">
            <color rgba="${rgba}"/>
          </material>
        </visual>
      </xacro:macro>
      <xacro:camera_visual_part mesh_index="0" rgba="0.035601 0.035601 0.035601 1"/>
      <xacro:camera_visual_part mesh_index="1" rgba="0.287440 0.665387 0.327778 1"/>
      <xacro:camera_visual_part mesh_index="2" rgba="0.799102 0.806952 0.799103 1"/>
      <xacro:camera_visual_part mesh_index="3" rgba="0.035601 0.035601 0.035601 1"/>
      <xacro:camera_visual_part mesh_index="4" rgba="0.296138 0.296138 0.296138 1"/>
      <xacro:camera_visual_part mesh_index="5" rgba="0.070360 0.070360 0.070360 1"/>
      <xacro:camera_visual_part mesh_index="6" rgba="0.070360 0.070360 0.070360 1"/>
      <xacro:camera_visual_part mesh_index="7" rgba="0.087140 0.002866 0.009346 1"/>
      <xacro:camera_visual_part mesh_index="8" rgba="1 1 1 1"/>

      <collision>
        <origin xyz="0 ${-d435_cam_depth_py} 0" rpy="0 0 0"/>
        <geometry>
          <box size="${d435_cam_depth} ${d435_cam_width} ${d435_cam_height}"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.072"/>
        <origin xyz="0 0 0"/>
        <inertia ixx="0.003881243" ixy="0.0" ixz="0.0" iyy="0.000498940" iyz="0.0" izz="0.003879257"/>
      </inertial>
    </link>

    <xacro:if value="${sim}">
      <joint name="${tf_prefix}camera_depth_joint" type="fixed">
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <parent link="${tf_prefix}camera_link"/>
        <child link="${tf_prefix}camera_depth_frame"/>
      </joint>
      <link name="${tf_prefix}camera_depth_frame"/>

      <joint name="${tf_prefix}camera_depth_optical_joint" type="fixed">
        <origin xyz="0 0 0" rpy="${-M_PI/2} 0 ${-M_PI/2}"/>
        <parent link="${tf_prefix}camera_depth_frame"/>
        <child link="${tf_prefix}camera_depth_optical_frame"/>
      </joint>
      <link name="${tf_prefix}camera_depth_optical_frame"/>

      <joint name="${tf_prefix}camera_infra1_joint" type="fixed">
        <origin xyz="0 ${d435_cam_depth_to_infra1_offset} 0" rpy="0 0 0"/>
        <parent link="${tf_prefix}camera_link"/>
        <child link="${tf_prefix}camera_infra1_frame"/>
      </joint>
      <link name="${tf_prefix}camera_infra1_frame"/>

      <joint name="${tf_prefix}camera_infra1_optical_joint" type="fixed">
        <origin xyz="0 0 0" rpy="${-M_PI/2} 0 ${-M_PI/2}"/>
        <parent link="${tf_prefix}camera_infra1_frame"/>
        <child link="${tf_prefix}camera_infra1_optical_frame"/>
      </joint>
      <link name="${tf_prefix}camera_infra1_optical_frame"/>

      <joint name="${tf_prefix}camera_infra2_joint" type="fixed">
        <origin xyz="0 ${d435_cam_depth_to_infra2_offset} 0" rpy="0 0 0"/>
        <parent link="${tf_prefix}camera_link"/>
        <child link="${tf_prefix}camera_infra2_frame"/>
      </joint>
      <link name="${tf_prefix}camera_infra2_frame"/>

      <joint name="${tf_prefix}camera_infra2_optical_joint" type="fixed">
        <origin xyz="0 0 0" rpy="${-M_PI/2} 0 ${-M_PI/2}"/>
        <parent link="${tf_prefix}camera_infra2_frame"/>
        <child link="${tf_prefix}camera_infra2_optical_frame"/>
      </joint>
      <link name="${tf_prefix}camera_infra2_optical_frame"/>

      <joint name="${tf_prefix}camera_color_joint" type="fixed">
        <origin xyz="0 ${d435_cam_depth_to_color_offset} 0" rpy="0 0 0"/>
        <parent link="${tf_prefix}camera_link"/>
        <child link="${tf_prefix}camera_color_frame"/>
      </joint>
      <link name="${tf_prefix}camera_color_frame"/>

      <joint name="${tf_prefix}camera_color_optical_joint" type="fixed">
        <origin xyz="0 0 0" rpy="${-M_PI/2} 0 ${-M_PI/2}"/>
        <parent link="${tf_prefix}camera_color_frame"/>
        <child link="${tf_prefix}camera_color_optical_frame"/>
      </joint>
      <link name="${tf_prefix}camera_color_optical_frame"/>
    </xacro:if>
  </xacro:macro>
</robot>
