<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">
  <!--
    Hand-E gripper macro from robotiq-cri, adapted for gz-sim:
    - meshes installed under ur_gripper_sim (not robotiq_description)
    - gz-valid inertias
    - no ROS 1 transmissions or Classic Gazebo plugins
  -->
  <xacro:macro name="robotiq_hande_gripper" params="prefix parent *origin">

    <joint name="${prefix}robotiq_hande_base_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${prefix}hand_e_link"/>
      <xacro:insert_block name="origin"/>
    </joint>

    <link name="${prefix}hand_e_link">
      <inertial>
        <origin rpy="0 0 0" xyz="0 0 0.04607"/>
        <mass value="0.86387"/>
        <inertia ixx="1.017560e-3" ixy="0" ixz="2.235e-6" iyy="1.028041e-3" iyz="0" izz="4.89810e-4"/>
      </inertial>
      <visual>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <mesh filename="package://ur_gripper_sim/meshes/hande/hand-e.dae" scale="1.0 1.0 1.0"/>
        </geometry>
        <material name="Dark">
          <color rgba="0.1 0.1 0.1 1.0"/>
        </material>
      </visual>
      <collision>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <mesh filename="package://ur_gripper_sim/meshes/hande/hand-e-collision.dae" scale="1.0 1.0 1.0"/>
        </geometry>
      </collision>
    </link>

    <link name="${prefix}hande_left_finger">
      <inertial>
        <origin rpy="0 0 0" xyz="0.02262 -0.00759 0.00738"/>
        <mass value="0.03804"/>
        <inertia ixx="1.4e-5" ixy="0" ixz="0" iyy="1.6e-5" iyz="0" izz="7.5e-6"/>
      </inertial>
      <visual>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <mesh filename="package://ur_gripper_sim/meshes/hande/finger_1.dae" scale="1.0 1.0 1.0"/>
        </geometry>
        <material name="DarkGray">
          <color rgba="0.4 0.4 0.4 1.0"/>
        </material>
      </visual>
      <collision>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <mesh filename="package://ur_gripper_sim/meshes/hande/finger_1-collision.dae" scale="1.0 1.0 1.0"/>
        </geometry>
      </collision>
    </link>

    <link name="${prefix}hande_right_finger">
      <inertial>
        <origin rpy="0 0 0" xyz="-0.02262 0.00759 0.00738"/>
        <mass value="0.03804"/>
        <inertia ixx="1.4e-5" ixy="0" ixz="0" iyy="1.6e-5" iyz="0" izz="7.5e-6"/>
      </inertial>
      <visual>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <mesh filename="package://ur_gripper_sim/meshes/hande/finger_2.dae" scale="1.0 1.0 1.0"/>
        </geometry>
        <material name="DarkGray">
          <color rgba="0.4 0.4 0.4 1.0"/>
        </material>
      </visual>
      <collision>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <mesh filename="package://ur_gripper_sim/meshes/hande/finger_2-collision.dae" scale="1.0 1.0 1.0"/>
        </geometry>
      </collision>
    </link>

    <!-- Travel capped to a jam-free range for gz: the real Hand-E stroke is 0..0.025 per
         finger, but in gz the fingers interpenetrate (jam) near the fully-open (0) and
         fully-closed (>~0.022) extremes. gz physics enforces these joint limits, so even
         raw FollowJointTrajectory goals beyond them are clamped. -->
    <joint name="${prefix}finger_joint" type="prismatic">
      <origin rpy="0 0 0" xyz="0 0 0.099"/>
      <parent link="${prefix}hand_e_link"/>
      <child link="${prefix}hande_left_finger"/>
      <axis xyz="-1 0 0"/>
      <limit effort="130" lower="0.002" upper="0.02" velocity="0.15"/>
    </joint>
    <!-- Single-actuator Hand-E: the right finger mimics the actuated finger_joint. This is
         enforced by gz only with the bullet-featherstone physics engine (the default DART
         engine has no mimic-constraint support) — the launch selects it. -->
    <joint name="${prefix}hande_right_finger_joint" type="prismatic">
      <origin rpy="0 0 0" xyz="0 0 0.099"/>
      <parent link="${prefix}hand_e_link"/>
      <child link="${prefix}hande_right_finger"/>
      <axis xyz="1 0 0"/>
      <limit effort="130" lower="0.002" upper="0.02" velocity="0.15"/>
      <mimic joint="${prefix}finger_joint" multiplier="1" offset="0"/>
    </joint>

  </xacro:macro>
</robot>
