<?xml version="1.0"?>
<!--
  Hand-E mounting hardware from ur_gripper_gazebo/urdf/ur_gripper_hande.xacro.
  Gripper kinematics come from ur_gripper_sim/urdf/inc/robotiq_hande_gripper.xacro.

  PickNik ros2_robotiq_gripper (apt: ros-jazzy-robotiq-description) does not ship
  Hand-E — only 2F-85/140. Use that vendor stack for the 85 variant later.
-->
<robot xmlns:xacro="http://wiki.ros.org/xacro">

  <xacro:include filename="$(find ur_gripper_sim)/urdf/inc/robotiq_hande_gripper.xacro"/>

  <link name="robotiq_coupler">
    <visual>
      <geometry>
        <mesh filename="package://ur_gripper_sim/meshes/robotiq_85_coupler.stl"/>
      </geometry>
      <material name="flat_black">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://ur_gripper_sim/meshes/robotiq_85_coupler.stl"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="2.073e-05 1.45286e-03 -1.1049e-03" rpy="0 0 0"/>
      <mass value="0.168"/>
      <inertia ixx="6.69695624e-05" ixy="5.21511788e-09" ixz="-2.74383009e-08"
               iyy="7.85088161e-05" iyz="5.41105193e-07" izz="1.41819717e-04"/>
    </inertial>
  </link>

  <joint name="robotiq_coupler_joint" type="fixed">
    <origin xyz="0 0 0.004" rpy="0 0 ${-pi/2.0}"/>
    <parent link="tool0"/>
    <child link="robotiq_coupler"/>
  </joint>

  <link name="gripper_tip_link"/>
  <joint name="manipulator_dummy_joint" type="fixed">
    <origin xyz="0 0 0.1441" rpy="0 0 0"/>
    <parent link="robotiq_coupler"/>
    <child link="gripper_tip_link"/>
  </joint>

  <xacro:robotiq_hande_gripper prefix="" parent="robotiq_coupler">
    <origin xyz="0 0 0.004" rpy="0 0 ${-pi/2}"/>
  </xacro:robotiq_hande_gripper>

</robot>
