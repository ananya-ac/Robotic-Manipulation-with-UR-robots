<?xml version="1.0"?>
<!--
  UR + Robotiq Hand-E + D435 wrist camera, for gz-sim (Harmonic).

  Pure composition: includes ur_gripper_sim's existing standalone
  ur_gripper_hande_gz.urdf.xacro unmodified (its own <robot> wrapper is
  discarded by xacro:include, its contents are spliced in here), then adds
  the wrist camera from ur_camera_sim. Neither included package is edited or
  aware of the other.
-->
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="$(arg name)">

  <xacro:arg name="name" default="ur"/>
  <xacro:arg name="ur_type" default="ur3e"/>
  <xacro:arg name="tf_prefix" default=""/>
  <xacro:arg name="simulation_controllers" default=""/>
  <!-- Mount point, in tool0's own frame ("X+ left, Y+ up, Z+ front" per
       ur_description's flange-tool0 joint). Z is confirmed good at -0.03 (behind
       tool0, clear of the gripper's own envelope); X/Y default to 0 (centered).
       Tune live via robot_gz.launch.py's camera_offset/camera_offset_x/
       camera_offset_y args. -->
  <xacro:arg name="camera_offset" default="0"/>
  <xacro:arg name="camera_offset_x" default="0"/>
  <xacro:arg name="camera_offset_y" default="-0.0675"/>

  <xacro:include filename="$(find ur_gripper_sim)/urdf/ur_gripper_hande_gz.urdf.xacro"/>

  <!-- wrist camera, mounted on the UR tool flange (rigid regardless of gripper) -->
  <xacro:include filename="$(find ur_camera_sim)/urdf/inc/realsense_d435.xacro"/>
  <xacro:include filename="$(find ur_camera_sim)/urdf/inc/realsense_d435.gazebo.xacro"/>
  <!-- Centered on tool0, facing forward: tool0 is "X+ left, Y+ up, Z+ front" (see
       ur_description's flange-tool0 joint), and camera_link is "X+ forward, Y+ left,
       Z+ up" (REP-103 camera convention), so rpy="0 -pi/2 -pi/2" is the rotation that
       maps camera-forward/left/up onto tool0's front/left/up, respectively. -->
  <xacro:ur_camera_d435 parent="$(arg tf_prefix)tool0" tf_prefix="$(arg tf_prefix)" sim="true">
    <origin xyz="$(arg camera_offset_x) $(arg camera_offset_y) $(arg camera_offset)"
            rpy="0 -1.5707963267948966 -1.5707963267948966"/>
  </xacro:ur_camera_d435>
  <xacro:ur_camera_d435_gazebo_sensor tf_prefix="$(arg tf_prefix)"/>

</robot>
