<?xml version="1.0"?>
<!--
  gz-sim (Harmonic) rgbd_camera sensor plugin for the D435 mounted via
  realsense_d435.xacro. Sim-only: a real D435 has no equivalent URDF plugin,
  it publishes over the real realsense2_camera driver node instead.

  Requires realsense_d435.xacro to have been instantiated with sim:=true first
  (this macro attaches to ${tf_prefix}camera_link).

  Attached to camera_link, NOT camera_color_optical_frame: gz-sim's rendering
  sensors use gz's own native +X-forward/+Y-left/+Z-up convention (matches
  camera_link, built per REP-103), not the ROS optical convention's +Z-forward
  (gazebosim/gz-sensors#488: this is intentional, kept for Gazebo Classic
  compatibility). Attaching to camera_color_optical_frame (which IS Z-forward)
  made gz render along that frame's +X instead, off from the mesh's visible
  front by 90 degrees. Published image/camera_info frame_id will read
  "camera_link", not "camera_color_optical_frame": harmless for plain 2D
  image display (rviz Image, this package's camera_view.rviz), but matters if
  something later needs TF-correct point clouds. gz-sensors has an
  optical_frame_id tag meant for exactly this split (render frame vs published
  frame_id) but it had a parsing bug on Fortress (gazebosim/gz-sensors#384);
  unverified whether that's fixed on this Harmonic (gz-sim8) install, so not
  used here without testing it first.

  Defaults sourced from:
  - horizontal_fov / width / height / update_rate: the color-camera values used
    by the community realsense-gazebo reference xacros (issaiass and
    pal-robotics-forks realsense2_description _d435.gazebo.xacro), not from
    Intel's raw RGB-sensor spec (91.2 deg) which describes the unprocessed
    sensor before the driver's usual rectified output.
  - depth_near / depth_far: Intel's published D435 depth range, ~0.105 m
    hardware minimum to ~10 m max usable range (product spec page + distributor
    datasheet). color_near/color_far are generic visual clip planes, not a
    physical spec.

  NOTE: verify gz topic names with `gz topic -l` after first launch — the
  rgbd_camera plugin's exact sub-topic suffixes (image/depth_image/points/
  camera_info) should match what's assumed in config/camera_bridge.yaml.
-->
<robot xmlns:xacro="http://wiki.ros.org/xacro">
  <xacro:macro name="ur_camera_d435_gazebo_sensor" params="tf_prefix:=''
      topic:=camera update_rate:=30 width:=640 height:=480
      horizontal_fov:=1.211259 color_near:=0.1 color_far:=10.0
      depth_near:=0.105 depth_far:=10.0">
    <gazebo reference="${tf_prefix}camera_link">
      <sensor name="${tf_prefix}camera" type="rgbd_camera">
        <!-- Sensor-local pose offset, separate from camera_link's own TF orientation
             (which is independently verified correct via tf2_echo's quaternion output,
             not touched here). Empirical fix for the rendered image appearing upside
             down after the camera_link reattachment above: a 180 degree roll about X
             (gz's boresight/forward axis for this sensor) flips the image in-plane
             without changing look direction. Not derived from documented gz-sim axis
             conventions (couldn't confirm those precisely - see the comment above);
             confirm this actually fixes it, don't assume. -->
        <pose>0 0 0 3.14159265358979 0 0</pose>
        <camera>
          <horizontal_fov>${horizontal_fov}</horizontal_fov>
          <image>
            <width>${width}</width>
            <height>${height}</height>
          </image>
          <clip>
            <near>${color_near}</near>
            <far>${color_far}</far>
          </clip>
          <depth_camera>
            <clip>
              <near>${depth_near}</near>
              <far>${depth_far}</far>
            </clip>
          </depth_camera>
        </camera>
        <always_on>true</always_on>
        <update_rate>${update_rate}</update_rate>
        <visualize>true</visualize>
        <topic>${topic}</topic>
      </sensor>
    </gazebo>
  </xacro:macro>
</robot>
